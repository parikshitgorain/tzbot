{
  "name": "tzbot-discord-bot",
  "version": "1.0.22",
  "description": "Comprehensive Discord moderation and engagement bot with Kick.com integration",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "commands:clear": "tsx scripts/clear-commands.ts",
    "logs:cleanup": "tsx scripts/cleanup-old-logs.ts",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:property": "vitest run tests/property",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run test:unit"
  },
  "keywords": [
    "discord",
    "bot",
    "moderation",
    "kick",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "pusher-js": "^8.4.0-rc2",
    "uuid": "^13.0.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.16",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint": "^10.0.1",
    "fast-check": "^3.15.1",
    "minimatch": "^10.2.2",
    "prettier": "^3.2.5",
    "semantic-release": "^25.0.3",
    "supertest": "^7.1.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "undici": "^7.22.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "minimatch": "^10.2.2",
    "undici": "^7.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
